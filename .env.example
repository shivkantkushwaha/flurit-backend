# ==============================================================================
# FLURIT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and adjust values for your environment:
#   copy .env.example .env
#
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# NOTE: Flurit uses an independent database instance. Never point this to Bynalt infrastructure.
# ==============================================================================

# Application Environment: development | staging | production | testing
ENVIRONMENT=development
# Deployment Tier: simplified (single-service college/demo project) | enterprise (multi-dyno Redis+ARQ)
DEPLOYMENT_TIER=simplified
PROJECT_NAME="Flurit"
VERSION="0.1.0"
API_V1_STR=/api/v1

# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false

# ------------------------------------------------------------------------------
# Database Configuration (Dedicated Flurit PostgreSQL)
# ------------------------------------------------------------------------------
# Example format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://flurit_app:flurit_password@localhost:5432/flurit_db

# Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# ------------------------------------------------------------------------------
# Supabase Authentication (JWT Verification)
# ------------------------------------------------------------------------------
# Public Supabase Project URL (ECDSA P-256 / ES256)
SUPABASE_URL=https://jhankemazkagrybaoitu.supabase.co
# Active JWT Algorithm (ES256 recommended for modern Supabase projects)
SUPABASE_JWT_ALGORITHM=ES256
# Expected JWT audience claim (aud)
SUPABASE_JWT_AUDIENCE=authenticated
# Expected JWT issuer claim (iss) - strictly verified in production
SUPABASE_JWT_ISSUER=https://jhankemazkagrybaoitu.supabase.co/auth/v1
# Optional override for JWKS endpoint (defaults to {SUPABASE_URL}/auth/v1/.well-known/jwks.json)
# SUPABASE_JWKS_URL=https://jhankemazkagrybaoitu.supabase.co/auth/v1/.well-known/jwks.json
# Whether to allow legacy HS256 tokens (strictly false by default)
SUPABASE_ALLOW_HS256=false
# Legacy Supabase JWT Secret (only required if SUPABASE_ALLOW_HS256=true, min 32 chars)
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder-minimum-32-chars
# Strictly enforce UUID format for subject 'sub' claim in non-production (always enforced in production)
SUPABASE_STRICT_SUB_UUID=false

# ------------------------------------------------------------------------------
# Security & CORS
# ------------------------------------------------------------------------------
# JSON list or comma-separated allowed origins for browser clients
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# Redis & Background Queue (ARQ)
# ------------------------------------------------------------------------------
# Queue broker mode:
#   - memory: in-process async task scheduler (default for simplified single-service deployment)
#   - disabled: gates async endpoints and directs clients to synchronous /onboarding/process
#   - sync: deterministic direct execution
#   - arq: production distributed queue backed by hosted Redis (requires enterprise tier)
QUEUE_MODE=memory
REDIS_URL=redis://localhost:6379/0
QUEUE_JOB_TIMEOUT_SECONDS=600
QUEUE_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# Temporary File Storage
# ------------------------------------------------------------------------------
# Storage backend: local | memory | s3
# NOTE: For multi-instance deployments on Railway/Render, ensure shared storage or S3 is used.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/uploads
STORAGE_CLEANUP_AFTER_PROCESSING=true
